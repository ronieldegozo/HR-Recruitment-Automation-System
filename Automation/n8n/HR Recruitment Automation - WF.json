              "type": "string",
              "value": "={{ String(($json.from && $json.from.value && $json.from.value[0] && $json.from.value[0].name) || \"\").replace(/^\"+|\"+$/g, \"\").trim() }}"
            },
            {
              "id": "a9",
              "name": "greeting_line",
              "type": "string",
              "value": "={{ (() => { const n = String(($json.from && $json.from.value && $json.from.value[0] && $json.from.value[0].name) || \"\").replace(/^\"+|\"+$/g, \"\").trim(); const e = n.replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\"); return n ? \"Hi, \" + e + \",\" : \"Hi there,\"; })() }}"
            },
            {
              "id": "a5",
              "name": "attachment_count",
              "type": "number",
              "value": "={{ Object.keys($binary || {}).length }}"
            },
            {
              "id": "a6",
              "name": "attachments",
              "type": "array",
              "value": "={{ Object.values($binary || {}).map(b => ({ fileName: b.fileName || \"\", fileExtension: String(b.fileExtension || \"\").toLowerCase(), mimeType: String(b.mimeType || \"\").toLowerCase(), fileSize: b.fileSize || \"unknown\" })) }}"
            },
            {
              "id": "a7",
              "name": "valid_cv_count",
              "type": "number",
              "value": "={{ Object.values($binary || {}).filter(b => { const name = String(b.fileName || \"\"); const ext = String(b.fileExtension || name.split(\".\").pop() || \"\").toLowerCase(); const mime = String(b.mimeType || \"\").toLowerCase(); const okType = (ext === \"pdf\" && mime === \"application/pdf\") || (ext === \"docx\" && mime === \"application/vnd.openxmlformats-officedocument.wordprocessingml.document\"); const parts = String(b.fileSize || \"\").trim().split(\" \"); const mult = { b: 1, kb: 1000, mb: 1000000, gb: 1000000000 }; const num = parseFloat(parts[0]); const unit = String(parts[1] || \"b\").toLowerCase(); const bytes = isNaN(num) ? null : num * (mult[unit] || 1); const okSize = bytes === null || bytes <= 10000000; return okType && okSize; }).length }}"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {
          "stripBinary": false
        }
      },

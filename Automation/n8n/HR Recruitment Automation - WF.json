    {
      "parameters": {
        "operation": "executeQuery",
        "query": "insert into public.job_applications\n  (applicant_email, applicant_name, gmail_message_id, gmail_thread_id, email_subject, resume_files, status,\n   extracted_full_name, applicant_mobile_number, home_address, work_experience, extraction_status, extracted_at)\nvalues\n  ($1, coalesce(nullif($2, ''), nullif($3, '')), $4, $5, $6, $7::jsonb, 'received',\n   $8, $9, $10, $11::jsonb, $12, $13::timestamptz)\non conflict (gmail_message_id) do update set\n  applicant_name = coalesce(nullif(excluded.applicant_name, ''), job_applications.applicant_name),\n  resume_files = excluded.resume_files,\n  extracted_full_name = excluded.extracted_full_name,\n  applicant_mobile_number = excluded.applicant_mobile_number,\n  home_address = excluded.home_address,\n  work_experience = excluded.work_experience,\n  extraction_status = excluded.extraction_status,\n  extracted_at = excluded.extracted_at\nreturning id, $14::boolean as should_acknowledge;",
        "options": {
          "queryReplacement": "={{ [\n $('Normalize Extracted CV Fields').item.json.sender_email,\n $('Normalize Extracted CV Fields').item.json.extracted_full_name || '',\n $('Normalize Extracted CV Fields').item.json.sender_name || '',\n $('Normalize Extracted CV Fields').item.json.gmail_message_id,\n $('Normalize Extracted CV Fields').item.json.gmail_thread_id || null,\n $('Normalize Extracted CV Fields').item.json.subject || null,\n JSON.stringify($('Normalize Extracted CV Fields').item.json.attachments || []),\n $('Normalize Extracted CV Fields').item.json.extracted_full_name,\n $('Normalize Extracted CV Fields').item.json.applicant_mobile_number,\n $('Normalize Extracted CV Fields').item.json.home_address,\n JSON.stringify($('Normalize Extracted CV Fields').item.json.work_experience || []),\n $('Normalize Extracted CV Fields').item.json.extraction_status,\n $('Normalize Extracted CV Fields').item.json.extracted_at,\n $('Normalize Extracted CV Fields').item.json.should_acknowledge === true\n] }}"
        }
      },

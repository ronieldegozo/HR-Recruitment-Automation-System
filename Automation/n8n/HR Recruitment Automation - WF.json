        "jsCode": "const raw=$json||{};let value;\nif(Array.isArray(raw.output)){for(const block of raw.output){if(block?.type==='message'&&Array.isArray(block.content)){const part=block.content.find(c=>(c?.type==='output_text'||c?.type==='text')&&typeof c.text==='string');if(part?.text){value=part.text;break;}}}}\nif(value===undefined&&typeof raw.output_text==='string')value=raw.output_text;\nif(value===undefined&&typeof raw.response?.output_text==='string')value=raw.response.output_text;\nif(value===undefined&&typeof raw.text==='string')value=raw.text;\nif(value===undefined&&raw.data&&typeof raw.data==='object')value=raw.data;\nif(typeof value==='string'){try{value=JSON.parse(value.trim());}catch{const a=value.indexOf('{'),b=value.lastIndexOf('}');if(a>=0&&b>a)value=JSON.parse(value.slice(a,b+1));else throw new Error('AI response was not valid JSON');}}\nif(value&&typeof value==='object'&&!Array.isArray(value))value=value.extracted??value.data??value;\nif(!value||typeof value!=='object'||Array.isArray(value))throw new Error('AI returned no structured applicant data');\nconst prep=$('Merge Applicant and Ack Lookup').item.json,details=value.personal_details||{};\nconst textOrNull=v=>typeof v==='string'&&v.trim()?v.trim():null;\nconst rows=Array.isArray(value.work_experience)?value.work_experience:Array.isArray(value.employment_history)?value.employment_history:[];\nconst experiences=rows.map(e=>({employer:textOrNull(e?.employer??e?.company),job_title:textOrNull(e?.job_title??e?.title??e?.position),start_date:textOrNull(e?.start_date),end_date:textOrNull(e?.end_date),summary:textOrNull(e?.summary??e?.description)}));\nconst fullName=textOrNull(value.full_name??details.name);\nreturn{json:{...prep,extracted_full_name:fullName,applicant_mobile_number:textOrNull(value.mobile_number??value.phone??details.phone),home_address:textOrNull(value.home_address??value.address??details.address),work_experience:experiences,extraction_status:fullName||experiences.length?'completed':'needs_review',extracted_at:new Date().toISOString()}};"
